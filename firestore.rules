rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // DO NOT DEPLOY unless the server has FIREBASE_ADMIN_* credentials. Without them the server uses
    // the browser SDK, which these rules would block, and the app would lose all data access.
    //
    // HRMS data is reached only through the Next.js server. The Admin SDK bypasses
    // these rules, so denying every browser read and write protects employee, payroll,
    // KYC and session data. This app does not use Firebase Auth, so rules cannot
    // identify users; never write request.auth conditions here.
    match /{document=**} {
      allow read, write: if false;
    }

    // Used from the browser by the separate Credit Expert dashboard app.
    // Rules are OR-ed, so these stay open even though the wildcard above denies the rest.
    match /credit_reports/{reportId} {
      allow read, write: if true;
    }
    match /access_codes/{codeId} {
      allow read, write: if true;
    }
    match /access_code_creditexpert/{codeId} {
      allow read, write: if true;
    }
  }
}
