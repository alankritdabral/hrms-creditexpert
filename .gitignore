# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (allow .env.example template)
.env*
!.env.example

# local user uploads / KYC files
/public/uploads/*
!/public/uploads/.gitkeep

# firebase debug logs
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Local fallback storage for uploaded KYC files (served via /uploads with auth)
/.uploads/

# Firebase / Google Cloud service-account keys (never commit these)
*firebase-adminsdk*.json
*service-account*.json
serviceAccount*.json
.firebase/

# other logs and local editor/tool state
*.log
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.claude/settings.local.json
