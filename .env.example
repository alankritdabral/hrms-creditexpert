# ==========================================
# HRMS Portal Environment Configuration
# Copy this file to .env.local and populate with your credentials.
# ==========================================

# 2. Cloudinary KYC Document Storage (Strict 2 MB per document limit enforced in app code)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# 3. SMTP Mail Platform Configuration (OTP Delivery & Notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_email@domain.com"
SMTP_PASS="your_smtp_app_password"
SMTP_FROM="your_email@domain.com"

# 4. App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. Vercel Cron (attendance reminder). Vercel sends this as a Bearer token to cron routes.
CRON_SECRET="generate_a_random_16+_char_secret"

# --- Data store: AWS RDS through the backend API (NodeBankend-Server) ---
# All HRMS data (employees, attendance, payroll, ...) and uploaded KYC files (S3) live behind the backend.
# BACKEND_API_KEY must equal DASHBOARD_API_KEY in the backend's .env.
BACKEND_API_URL="https://your-backend.example.com/api/v1"
BACKEND_API_KEY="shared_secret_at_least_32_chars"
