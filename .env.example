# ==========================================
# HRMS Portal Environment Configuration
# Copy this file to .env.local and populate with your credentials.
# ==========================================

# 1. Firebase & Firestore Client Configuration (Google Cloud Firestore Exclusive)
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_firebase_app_id"

# 2. Cloudinary KYC Document Storage (Strict 2 MB per document limit enforced in app code)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# 3. SMTP Mail Platform Configuration (OTP Delivery & Notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_email@domain.com"
SMTP_PASS="your_smtp_app_password"
SMTP_FROM="your_email@domain.com"

# 4. App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
