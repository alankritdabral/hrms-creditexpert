# ==========================================
# HRMS Portal Environment Configuration
# Copy this file to .env.local and populate with your credentials.
# ==========================================

# 1. Firebase. The server needs ONE of these two to reach Firestore:
#    (a) Web config (works on the free Spark plan; Firestore rules must allow access, so data is
#        only as protected as firestore.rules). Firebase console > Project settings > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY="your_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"
#    (b) Admin service account (recommended: lets you deploy deny-all firestore.rules so only this
#        server can read data). Used instead of (a) when all three are set.
#        Firebase console > Project settings > Service accounts. Keep the \n escapes; never commit it.
# FIREBASE_ADMIN_PROJECT_ID="your_project_id"
# FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com"
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 2. Cloudinary KYC Document Storage (Strict 2 MB per document limit enforced in app code)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# 3. SMTP Mail Platform Configuration (OTP Delivery & Notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_email@domain.com"
SMTP_PASS="your_smtp_app_password"
SMTP_FROM="your_email@domain.com"

# 4. App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. Vercel Cron (attendance reminder). Vercel sends this as a Bearer token to cron routes.
CRON_SECRET="generate_a_random_16+_char_secret"
